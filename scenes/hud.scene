id: 2440765117
name: HUD
scene:
  backgroundColor: [0.525, 0.525, 0.525, 1]
  shadowQuality: low
  meshLodEnabled: false
  meshLodThreshold: 1
  depthPrepassEnabled: false
  lightState: off
  globalIlluminationIntensity: 0.1
  globalIlluminationColor: [1, 1, 1]
  ambientLight2DIntensity: 1
  ambientLight2DColor: [1, 1, 1]
  shadow2DQuality: low
  ssaoEnabled: false
  ssaoRadius: 0.5
  ssaoIntensity: 1
  ssaoBias: 0.025
  ssaoHalfResolution: false
  ssrEnabled: false
  ssrMaxDistance: 8
  ssrThickness: 0.5
  ssrMaxSteps: 48
  ssrIntensity: 1
  ssrBlur: 0
  gravity2D: [0, -9.81]
  gravity3D: [0, -9.81, 0]
  fixedResolutionEnabled: false
  fixedResolutionWidth: 640
  fixedResolutionHeight: 360
  fixedResolutionFilter: nearest
  enableUIEvents: not_set
sceneType: scene_ui
mainCamera: 0
visibilityInherited: true
maxValues:
  maxSubmeshes: 0
  maxTilemapTilesRect: 0
  maxTilemapTiles: 0
  maxExternalBuffers: 0
  maxSpriteFrames: 0
  maxBones: 0
  maxShapes2D: 0
  maxShapePoints2D: 0
  maxShapes3D: 0
  maxShapeVertices3D: 0
  maxShapeIndices3D: 0
shaderKeys:
  - type: ui
    properties: 2
  - type: ui
    properties: 9
  - type: blit
entities:
  - type: Entity
    entity: 1022
    name: HUDController
    components:
      script:
        scripts:
          - type: lua
            path: hud_controller.lua
            className: HUDController
            enabled: true
            properties:
              - name: selfTest
                displayName: Self Test
                type: Bool
                value: false
                defaultValue: false
              - name: demo
                displayName: Visual Demo
                type: Bool
                value: false
                defaultValue: false
              - name: demoGuide
                displayName: Visual Demo (Guide)
                type: Bool
                value: false
                defaultValue: false
              - name: demoFinale
                displayName: Visual Demo (Finale)
                type: Bool
                value: false
                defaultValue: false
